{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "shell:default",
    "shell:allow-spawn",
    "shell:allow-execute",
    "shell:allow-stdin-write",
    "shell:allow-kill",
    "shell:allow-open",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-read-dir",
    "os:default",
    "os:allow-os-type",
    "os:allow-platform",
    "os:allow-arch",
    "process:default",
    "process:allow-exit",
    "clipboard-manager:default",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "http:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://localhost:8847/**" },
        { "url": "http://127.0.0.1:8847/**" }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        { "name": "binaries/llama-server", "sidecar": true, "args": true }
      ]
    }
  ]
}
