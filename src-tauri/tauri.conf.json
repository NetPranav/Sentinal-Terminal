{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sentinel Terminal",
  "version": "2.0.0",
  "identifier": "com.pranav.sentinel-terminal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sentinel Terminal",
        "width": 1024,
        "height": 768
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Autonomous AI-Native Linux Terminal Copilot",
    "longDescription": "High-performance AI-native Linux terminal emulator with embedded llama-server, multi-stage workflow macros, and native system diagnostics.",
    "copyright": "2026 Sentinel Terminal Contributors",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37",
          "libappindicator3-1 | libayatana-appindicator3-1",
          "openssl"
        ]
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "openssl"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}

