#!/usr/bin/env bash

# Sentinel Terminal Command Line Launcher
# Communicates with Sentinel Terminal desktop application via macOS custom protocols and application activation

APP_NAME="Sentinel Terminal"

show_help() {
  echo "Sentinel Terminal CLI — First-Class macOS Terminal Emulator Integration"
  echo "Usage:"
  echo "  sentinel [path]           Open a new terminal session at [path] (defaults to current directory)"
  echo "  sentinel --new-tab [path] Open a new tab in the active terminal window"
  echo "  sentinel --split [path]   Split the current active terminal pane"
  echo "  sentinel --run <cmd>      Launch terminal and immediately execute <cmd>"
  echo "  sentinel --help, -h       Display this usage guide"
}

if [ "$1" == "--help" ] || [ "$1" == "-h" ]; then
  show_help
  exit 0
fi

# Function to resolve absolute filesystem paths
resolve_path() {
  local target="$1"
  if [ -z "$target" ]; then
    target="."
  fi
  python3 -c 'import os, sys; print(os.path.abspath(os.path.expanduser(sys.argv[1])))' "$target" 2>/dev/null || (cd "$target" 2>/dev/null && pwd)
}

# Function to URL encode strings for protocol transmission
url_encode() {
  python3 -c 'import urllib.parse, sys; print(urllib.parse.quote(sys.argv[1]))' "$1" 2>/dev/null || echo "$1"
}

if [ "$1" == "--new-tab" ]; then
  ABS_PATH=$(resolve_path "${2:-.}")
  ENCODED_PATH=$(url_encode "$ABS_PATH")
  open "sentinel://new-tab?path=$ENCODED_PATH" 2>/dev/null || open -a "$APP_NAME" "$ABS_PATH"
  exit 0
elif [ "$1" == "--split" ]; then
  ABS_PATH=$(resolve_path "${2:-.}")
  ENCODED_PATH=$(url_encode "$ABS_PATH")
  open "sentinel://split?path=$ENCODED_PATH" 2>/dev/null || open -a "$APP_NAME" "$ABS_PATH"
  exit 0
elif [ "$1" == "--run" ] || [ "$1" == "-r" ]; then
  shift
  CMD_TEXT="$*"
  ENCODED_CMD=$(url_encode "$CMD_TEXT")
  CURRENT_DIR=$(resolve_path ".")
  ENCODED_DIR=$(url_encode "$CURRENT_DIR")
  open "sentinel://run?cmd=$ENCODED_CMD&path=$ENCODED_DIR" 2>/dev/null || open -a "$APP_NAME" "$CURRENT_DIR"
  exit 0
else
  ABS_PATH=$(resolve_path "${1:-.}")
  ENCODED_PATH=$(url_encode "$ABS_PATH")
  # Launch via URL scheme or fallback directly to open -a Application
  open "sentinel://open?path=$ENCODED_PATH" 2>/dev/null || open -a "$APP_NAME" "$ABS_PATH"
  exit 0
fi
