{
  "toolId": "browser.navigate",
  "version": "1.0.0",
  "description": "Executes native driver for Navigate Browser to URL.",
  "steps": [
    {
      "id": "step_exec_main",
      "name": "Execute Navigate Browser to URL",
      "type": "ExecuteCapability",
      "capabilityId": "browser.navigate",
      "parameters": {
        "url": "{{url}}",
        "appName": "{{appName}}"
      },
      "dependencies": [],
      "onError": "fail"
    }
  ],
  "successCondition": "step:step_exec_main:success",
  "errorHandling": {
    "strategy": "fail_fast",
    "maxRetries": 0
  }
}
