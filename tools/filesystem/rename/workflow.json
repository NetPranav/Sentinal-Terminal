{
  "toolId": "filesystem.rename",
  "version": "1.0.0",
  "description": "Executes native driver for Rename File or Directory.",
  "steps": [
    {
      "id": "step_exec_main",
      "name": "Execute Rename File or Directory",
      "type": "ExecuteCapability",
      "capabilityId": "filesystem.rename",
      "parameters": {
        "path": "{{path}}",
        "newName": "{{newName}}"
      },
      "dependencies": [],
      "onError": "fail"
    }
  ],
  "successCondition": "step:step_exec_main:success",
  "errorHandling": {
    "strategy": "fail_fast",
    "maxRetries": 0
  }
}
