{
  "toolId": "filesystem.list",
  "version": "1.0.0",
  "description": "Executes native driver for List Directory Contents.",
  "steps": [
    {
      "id": "step_exec_main",
      "name": "Execute List Directory Contents",
      "type": "ExecuteCapability",
      "capabilityId": "filesystem.list",
      "parameters": {
        "command": "ls",
        "args": [
          "-la",
          "{{path}}"
        ],
        "path": "{{path}}"
      },
      "dependencies": [],
      "onError": "fail"
    }
  ],
  "successCondition": "step:step_exec_main:success",
  "errorHandling": {
    "strategy": "fail_fast",
    "maxRetries": 0
  }
}
