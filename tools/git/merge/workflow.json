{
  "toolId": "git.merge",
  "version": "1.0.0",
  "description": "Executes native driver for Merge Git Branch.",
  "steps": [
    {
      "id": "step_exec_main",
      "name": "Execute Merge Git Branch",
      "type": "ExecuteCapability",
      "capabilityId": "git.merge",
      "parameters": {
        "branch": "{{branch}}"
      },
      "dependencies": [],
      "onError": "fail"
    }
  ],
  "successCondition": "step:step_exec_main:success",
  "errorHandling": {
    "strategy": "fail_fast",
    "maxRetries": 0
  }
}
