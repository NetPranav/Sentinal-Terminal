{
  "toolId": "shell.execute",
  "version": "1.0.0",
  "description": "Executes native driver for Execute Terminal Shell Command.",
  "steps": [
    {
      "id": "step_exec_main",
      "name": "Execute Execute Terminal Shell Command",
      "type": "ExecuteCapability",
      "capabilityId": "shell.execute",
      "parameters": {
        "command": "{{command}}",
        "cwd": "{{cwd}}"
      },
      "dependencies": [],
      "onError": "fail"
    }
  ],
  "successCondition": "step:step_exec_main:success",
  "errorHandling": {
    "strategy": "fail_fast",
    "maxRetries": 0
  }
}
