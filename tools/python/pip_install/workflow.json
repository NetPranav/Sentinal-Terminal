{
  "toolId": "python.pip_install",
  "version": "1.0.0",
  "description": "Executes native driver for Install Python Pip Package.",
  "steps": [
    {
      "id": "step_exec_main",
      "name": "Execute Install Python Pip Package",
      "type": "ExecuteCapability",
      "capabilityId": "python.pip_install",
      "parameters": {
        "package": "{{package}}",
        "upgrade": "{{upgrade}}"
      },
      "dependencies": [],
      "onError": "fail"
    }
  ],
  "successCondition": "step:step_exec_main:success",
  "errorHandling": {
    "strategy": "fail_fast",
    "maxRetries": 0
  }
}
