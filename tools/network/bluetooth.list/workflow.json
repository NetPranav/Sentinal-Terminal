{
  "toolId": "network.bluetooth.list",
  "version": "1.0.0",
  "description": "Executes native driver for List Bluetooth Devices.",
  "steps": [
    {
      "id": "step_exec_main",
      "name": "Execute List Bluetooth Devices",
      "type": "ExecuteCapability",
      "capabilityId": "shell.core",
      "parameters": {
        "command": "system_profiler",
        "args": [
          "SPBluetoothDataType"
        ]
      },
      "dependencies": [],
      "onError": "fail"
    }
  ],
  "successCondition": "step:step_exec_main:success",
  "errorHandling": {
    "strategy": "fail_fast",
    "maxRetries": 1
  }
}
