# Maintainer: Sentinel Terminal Contributors <support@sentinel-terminal.org>
pkgname=sentinel-terminal-bin
pkgver=2.0.0
pkgrel=1
pkgdesc="Autonomous AI-Native Linux Terminal Copilot"
arch=('x86_64')
url="https://github.com/NetPranav/Sentinal-Terminal"
license=('MIT')
depends=(
    'webkit2gtk-4.1'
    'gtk3'
    'openssl'
    'libappindicator-gtk3'
)
optdepends=(
    'networkmanager: Wi-Fi network inspection and interface management'
    'bluez: Bluetooth device discovery and connectivity'
    'ollama: External AI reasoning model provider'
)
provides=('sentinel-terminal')
conflicts=('sentinel-terminal')

package() {
    # Binary installation (tauri-app built from release profile)
    if [ -f "${srcdir}/sentinel-terminal" ]; then
        install -Dm755 "${srcdir}/sentinel-terminal" "${pkgdir}/usr/bin/sentinel-terminal"
    else
        install -Dm755 "${srcdir}/tauri-app" "${pkgdir}/usr/bin/sentinel-terminal"
    fi

    # Desktop entry installation
    install -Dm644 "${srcdir}/com.pranav.sentinel-terminal.desktop" \
        "${pkgdir}/usr/share/applications/com.pranav.sentinel-terminal.desktop"

    # Application icons installation
    if [ -f "${srcdir}/icons/32x32.png" ]; then
        install -Dm644 "${srcdir}/icons/32x32.png" \
            "${pkgdir}/usr/share/icons/hicolor/32x32/apps/sentinel-terminal.png"
    fi
    if [ -f "${srcdir}/icons/128x128.png" ]; then
        install -Dm644 "${srcdir}/icons/128x128.png" \
            "${pkgdir}/usr/share/icons/hicolor/128x128/apps/sentinel-terminal.png"
    fi
    if [ -f "${srcdir}/icons/icon.png" ]; then
        install -Dm644 "${srcdir}/icons/icon.png" \
            "${pkgdir}/usr/share/icons/hicolor/512x512/apps/sentinel-terminal.png"
    fi
}
