# Maintainer: Sentinel Terminal Contributors
pkgname=sentinel-terminal-bin
pkgver=2.0.0
pkgrel=1
pkgdesc="Autonomous AI-Native Linux Terminal Copilot"
arch=('x86_64')
license=('Apache-2.0')
depends=(
    'webkit2gtk-4.1'
    'gtk3'
    'openssl'
    'glib2'
    'cairo'
    'pango'
)
optdepends=(
    'vte3: Enhanced terminal capability support'
    'curl: Network diagnostic features'
)
provides=('sentinel-terminal')
conflicts=('sentinel-terminal')
source=(
    "sentinel-terminal"
    "sentinel-terminal.desktop"
    "icon.png"
    "128x128.png"
    "32x32.png"
)
sha256sums=(
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
)

package() {
    # Install binary
    install -Dm755 "${srcdir}/sentinel-terminal" "${pkgdir}/usr/bin/sentinel-terminal"

    # Install desktop entry
    install -Dm644 "${srcdir}/sentinel-terminal.desktop" "${pkgdir}/usr/share/applications/sentinel-terminal.desktop"

    # Install icons
    install -Dm644 "${srcdir}/icon.png" "${pkgdir}/usr/share/icons/hicolor/512x512/apps/sentinel-terminal.png"
    install -Dm644 "${srcdir}/128x128.png" "${pkgdir}/usr/share/icons/hicolor/128x128/apps/sentinel-terminal.png"
    install -Dm644 "${srcdir}/32x32.png" "${pkgdir}/usr/share/icons/hicolor/32x32/apps/sentinel-terminal.png"
}
